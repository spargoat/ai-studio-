{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app/ui && npm ci && npm run build && cd ../.. && python3 scripts/stage_static.py",
  "functions": {
    "app/wsgi.py": {
      "maxDuration": 300,
      "excludeFiles": "{app/ui/node_modules/**,app/ui/src/**,app/ui/dist/assets/**,app/tests/**,app/screens/**,app/tools/**,app/models/**,app/bin/**,app/fonts/**,app/data/**,public/**,**/.git/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "crons": [
    { "path": "/api/cron/advance", "schedule": "* * * * *" }
  ]
}
